generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────
// BUSINESS
// ─────────────────────────────────────
model Business {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  slug           String    @unique
  contactNumber  String
  ownerName      String
  email          String    @unique
  whatsappNumber String
  address        String?
  gstNo          String?
  tagline        String?
  logoUrl        String?
  font           String    @default("Inter")
  theme          Json?
  planType       PlanType  @default(TRIAL)
  trialEndsAt    DateTime?
  planEndsAt     DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  deletedAt      DateTime?
  createdBy      String?   @db.ObjectId
  updatedBy      String?   @db.ObjectId

  users     User[]
  diamonds  Diamond[]
  inquiries Inquiry[]
  apiKeys   ApiKey[]
}

// ─────────────────────────────────────
// USER
// ─────────────────────────────────────
model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String?
  email        String    @unique
  passwordHash String
  role         Role      @default(OWNER)
  isActive     Boolean   @default(true)
  businessId   String?   @db.ObjectId
  business     Business? @relation(fields: [businessId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  deletedAt    DateTime?
  createdBy    String?   @db.ObjectId
  updatedBy    String?   @db.ObjectId
}

enum Role {
  SUPER_ADMIN
  OWNER
}

enum PlanType {
  TRIAL
  BASIC
  PRO
  ENTERPRISE
}

// ─────────────────────────────────────
// DIAMOND
// ─────────────────────────────────────
model Diamond {
  id                 String          @id @default(auto()) @map("_id") @db.ObjectId
  businessId         String          @db.ObjectId
  business           Business        @relation(fields: [businessId], references: [id])

  certificateNumber  String?
  certificateLab     CertificateLab?
  certificateFileUrl String?

  shape              String
  carat              Float
  color              String
  clarity            String
  cut                String?
  polish             String?
  symmetry           String?
  fluorescence       String?
  measurements       String? // Keep string as fallback, but add explicit floats for range filtering:

  // --- PROPORTIONS & MEASUREMENTS ---
  tablePercentage    Float?
  depthPercentage    Float?
  ratio              Float?
  length             Float?
  width              Float?
  depth              Float?

  // --- VISUAL CHARACTERISTICS ---
  shade              String?
  luster             String?
  culet              String?
  heartsAndArrows    String?

  // --- INCLUSIONS & FACETS ---
  tableInclusion     String?
  sideInclusion      String?
  tableBlack         String?
  sideBlack          String?
  extraFacet         String?
  girdle             String?
  tableOpen          String?
  sideOpen           String?

  // --- LOGISTICS & AVAILABILITY ---
  status             DiamondStatus @default(AVAILABLE)
  location           String?
  earlyBird          String?

  price              Float

  images             String[]
  videoUrl           String?

  uploadMethod       UploadMethod    @default(MANUAL)

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  deletedAt          DateTime?
  createdBy          String?         @db.ObjectId
  updatedBy          String?         @db.ObjectId

  inquiries          Inquiry[]
}

enum CertificateLab {
  GIA
  IGI
  HRD
  AGS
  JOB
  GSI
  OTHER
}

enum UploadMethod {
  CERTIFICATE_ID
  CERTIFICATE_FILE
  MANUAL
}

enum DiamondStatus {
  AVAILABLE
  HOLD
  SOLD
}

// ─────────────────────────────────────
// INQUIRY
// ─────────────────────────────────────
model Inquiry {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  businessId String   @db.ObjectId
  business   Business @relation(fields: [businessId], references: [id])
  diamondId  String?  @db.ObjectId
  diamond    Diamond? @relation(fields: [diamondId], references: [id])
  name       String
  email      String
  phone      String?
  message    String
  createdAt  DateTime @default(now())

  deletedAt  DateTime?
  createdBy  String?   @db.ObjectId
  updatedBy  String?   @db.ObjectId
}

// ─────────────────────────────────────
// REQUEST LOG
// ─────────────────────────────────────
model RequestLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  method       String
  path         String
  statusCode   Int
  responseTime Int
  ip           String?
  userId       String?
  userRole     String?
  userAgent    String?
  createdAt    DateTime @default(now())
}

// ─────────────────────────────────────
// API KEY (Developer Panel)
// ─────────────────────────────────────
model ApiKey {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  keyHash    String   @unique
  businessId String   @db.ObjectId
  business   Business @relation(fields: [businessId], references: [id])
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())

  deletedAt  DateTime?
  createdBy  String?   @db.ObjectId
  updatedBy  String?   @db.ObjectId
}

// ─────────────────────────────────────
// GLOBAL METADATA (Filter Configuration)
// ─────────────────────────────────────
model Metadata {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  
  // Stored as generic JSON to support complex tags (label, code, description, disabled, sortOrder)
  // Categories: shapes, colors, clarities, shades, lusters, cutGrades, polishGrades, symmetryGrades,
  // fluors, labs, locations, caratRanges, priceBands, origins, marketingTags, availabilityTags.
  config          Json?

  updatedAt       DateTime @updatedAt

  deletedAt       DateTime?
  createdBy       String?   @db.ObjectId
  updatedBy       String?   @db.ObjectId
}


